#!/bin/sh
echo "🎄 Обновление Christmas Linux"
echo ""

echo "🔄 Обновление APK пакетов..."
apk update && apk upgrade

echo "🐍 Обновление Python пакетов..."
pip3 list --outdated --format=freeze 2>/dev/null | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 pip3 install -U 2>/dev/null || echo "Python пакеты не обновлены"

echo "📦 Обновление NPM пакетов..."
npm update -g 2>/dev/null || echo "NPM пакеты не обновлены"

echo "✅ Обновление завершено!"
